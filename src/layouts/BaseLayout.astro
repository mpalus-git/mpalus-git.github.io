---
import "@/styles/global.css";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { apiOrigin, themeColor } from "@/config";
import {
  defaultLanguage,
  getLocalizedPath,
  getOtherLanguage,
  languages,
  t,
  type Language,
} from "@/i18n/i18n";
import { buildLanguageScript, hashScript } from "@/scripts/languagePreference";

type Props = {
  language: Language;
  title: string;
  description: string;
  noIndex?: boolean;
};

const { language, title, description, noIndex = false } = Astro.props;
const path = Astro.url.pathname;
const alternates = languages.map((code) => ({
  hreflang: code,
  href: new URL(getLocalizedPath(path, code), Astro.site).href,
}));
const canonicalHref = new URL(getLocalizedPath(path, language), Astro.site).href;
const ogLocales: Record<Language, string> = { pl: "pl_PL", en: "en_US" };
const ogImageHref = new URL("/og-image.png", Astro.site).href;
const defaultHref = new URL(getLocalizedPath(path, defaultLanguage), Astro.site).href;
const languageScript = buildLanguageScript();
Astro.csp?.insertScriptHash(await hashScript(languageScript));
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href={apiOrigin} crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex ? <meta name="robots" content="noindex" /> : null}
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(language, "personName")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:locale" content={ogLocales[language]} />
    <meta property="og:locale:alternate" content={ogLocales[getOtherLanguage(language)]} />
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(language, "ogImageAlt")} />
    <meta name="twitter:card" content="summary_large_image" />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col font-sans">
    <script is:inline set:html={languageScript} />
    <a
      href="#main"
      class="sr-only rounded-lg bg-surface font-semibold text-brand shadow-md focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-10 focus:px-4 focus:py-3"
    >
      {t(language, "skipToContent")}
    </a>
    <Header language={language} path={path} />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer language={language} />
    <script>
      import { startApiWake } from "@/scripts/wakeApi";

      startApiWake(window);
    </script>
  </body>
</html>
