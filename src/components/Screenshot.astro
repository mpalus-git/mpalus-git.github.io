---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

type Props = {
  image: ImageMetadata;
  alt: string;
  device: "desktop" | "phone";
  sizes?: string;
  class?: string;
};

const { image, alt, device, sizes, class: className } = Astro.props;
const widths =
  device === "phone"
    ? [280, 560].filter((width) => width <= image.width)
    : [480, 800, 1200, 1440].filter((width) => width <= image.width);
const defaultSizes =
  device === "phone" ? "280px" : "(min-width: 1152px) 1088px, calc(100vw - 2rem)";
---

<Picture
  src={image}
  alt={alt}
  formats={["avif", "webp"]}
  widths={widths}
  sizes={sizes ?? defaultSizes}
  loading="lazy"
  decoding="async"
  class:list={["h-auto", device === "phone" ? "w-full max-w-[280px]" : "w-full", className]}
/>
