---
import SystemDiagram from "@/components/SystemDiagram.astro";
import { t, type Language } from "@/i18n/i18n";

type Props = {
  language: Language;
};

const { language } = Astro.props;
---

<section
  id="fixflow"
  aria-labelledby="fixflow-heading"
  class="mx-auto max-w-6xl px-4 py-16 md:px-8"
>
  <div class="grid items-center gap-10 md:grid-cols-2">
    <div>
      <h2 id="fixflow-heading" class="text-3xl font-bold tracking-tight md:text-4xl">
        {t(language, "fixflowHeading")}
      </h2>
      <p class="mt-4 max-w-prose text-lg leading-relaxed text-muted">
        {t(language, "fixflowIntro")}
      </p>
    </div>
    <div class="flex justify-center">
      <SystemDiagram language={language} />
    </div>
  </div>
</section>
