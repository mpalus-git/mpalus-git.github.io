---
import { getCollection } from "astro:content";
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import SystemDiagram from "@/components/SystemDiagram.astro";
import { t, type Language } from "@/i18n/i18n";

type Props = {
  language: Language;
};

const { language } = Astro.props;
const projects = (
  await getCollection("projects", (entry) => entry.id.startsWith(`${language}/`))
).sort((first, second) => first.data.order - second.data.order);
---

<section
  id="fixflow"
  aria-labelledby="fixflow-heading"
  class="mx-auto max-w-6xl px-4 py-16 md:px-8"
>
  <div class="grid items-start gap-10 md:grid-cols-2">
    <div>
      <SectionHeading id="fixflow-heading">{t(language, "fixflowHeading")}</SectionHeading>
      <p class="mt-4 max-w-prose text-lg leading-relaxed text-muted">
        {t(language, "fixflowIntro")}
      </p>
    </div>
    <div class="flex justify-center">
      <SystemDiagram language={language} />
    </div>
  </div>
  <ul class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => (
      <li>
        <ProjectCard project={project} language={language} />
      </li>
    ))}
  </ul>
</section>
