---
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { getProjects } from "@/content/projects";
import { t, type Language } from "@/i18n/i18n";

type Props = {
  language: Language;
};

const { language } = Astro.props;
const projects = await getProjects(language);
---

<section
  id="fixflow"
  aria-labelledby="fixflow-heading"
  class="mx-auto max-w-6xl px-4 py-16 md:px-8"
>
  <SectionHeading id="fixflow-heading">{t(language, "fixflowHeading")}</SectionHeading>
  <ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => (
      <li>
        <ProjectCard project={project} language={language} />
      </li>
    ))}
  </ul>
</section>
