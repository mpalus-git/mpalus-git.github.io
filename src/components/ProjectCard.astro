---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import type { CollectionEntry } from "astro:content";
import ApiArchitectureDiagram from "@/components/ApiArchitectureDiagram.astro";
import ProjectLinks from "@/components/ProjectLinks.astro";
import Screenshot from "@/components/Screenshot.astro";
import TechList from "@/components/TechList.astro";
import { getLocalizedPath, t, type Language } from "@/i18n/i18n";

type Props = {
  project: CollectionEntry<"projects">;
  language: Language;
};

const { project, language } = Astro.props;
const cover = project.data.cover
  ? { ...project.data.cover, device: "desktop" as const }
  : project.data.screenshots[0];
const detailsHref = getLocalizedPath(`/${project.data.project}/`, language);
const detailsLabel = t(language, "projectDetailsLabel").replace("{title}", project.data.title);
---

<article class="flex h-full flex-col overflow-hidden rounded-xl border border-border bg-surface transition-colors hover:border-brand">
  <div class="flex aspect-[16/10] items-start justify-center overflow-hidden border-b border-border bg-brand-tint">
    {project.data.project === "fixflow-api" ? (
      <ApiArchitectureDiagram language={language} class="m-auto h-auto w-full max-w-sm p-5" />
    ) : cover?.device === "phone" ? (
      <Screenshot
        image={cover.image}
        alt={cover.alt}
        device="phone"
        sizes="(min-width: 1024px) 150px, 45vw"
        class="mt-6 h-auto w-[45%] rounded-t-xl shadow-md"
      />
    ) : cover ? (
      <Screenshot
        image={cover.image}
        alt={cover.alt}
        device="desktop"
        sizes="(min-width: 1024px) 352px, (min-width: 768px) 50vw, 100vw"
        class="h-auto w-full"
      />
    ) : null}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-bold">
      <a
        href={detailsHref}
        aria-label={detailsLabel}
        class="inline-flex min-h-11 items-center gap-2 decoration-2 underline-offset-4 hover:text-brand hover:underline"
      >
        {project.data.title}
        <ArrowRight size={20} class="text-brand" />
      </a>
    </h3>
    <p class="mt-2 text-muted">{project.data.summary}</p>
    <TechList
      technologies={project.data.stack.slice(0, 4)}
      label={t(language, "projectStackLabel")}
      class="mt-4 text-muted"
    />
    <ProjectLinks
      links={project.data.links}
      language={language}
      projectTitle={project.data.title}
      class="mt-auto pt-6"
    />
  </div>
</article>
