---
import type { CollectionEntry } from "astro:content";
import ApiArchitectureDiagram from "@/components/ApiArchitectureDiagram.astro";
import ExternalLink from "@/components/ExternalLink.astro";
import { getProjectActions } from "@/components/projectActions";
import Screenshot from "@/components/Screenshot.astro";
import { t, type Language } from "@/i18n/i18n";

type Props = {
  project: CollectionEntry<"projects">;
  language: Language;
};

const { project, language } = Astro.props;
const cover = project.data.screenshots[0];
const actions = getProjectActions(project.data.links, language);
---

<article class="flex h-full flex-col overflow-hidden rounded-xl border border-t-4 border-border border-t-brand bg-surface shadow-sm">
  <div class="flex aspect-[16/10] items-start justify-center overflow-hidden border-b border-border bg-brand-tint">
    {project.data.project === "fixflow-api" ? (
      <ApiArchitectureDiagram language={language} class="m-auto h-auto w-full p-5" />
    ) : cover?.device === "phone" ? (
      <Screenshot
        image={cover.image}
        alt={cover.alt}
        device="phone"
        sizes="(min-width: 1024px) 150px, 45vw"
        class="mt-6 h-auto w-[45%] rounded-t-xl shadow-md"
      />
    ) : cover ? (
      <Screenshot
        image={cover.image}
        alt={cover.alt}
        device="desktop"
        sizes="(min-width: 1024px) 352px, (min-width: 768px) 50vw, 100vw"
        class="h-auto w-full"
      />
    ) : null}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-bold">{project.data.title}</h3>
    <p class="mt-2 text-muted">{project.data.summary}</p>
    <ul aria-label={t(language, "projectStackLabel")} class="mt-4 flex flex-wrap gap-2">
      {project.data.stack.map((technology) => (
        <li class="rounded-full bg-brand-tint px-3 py-1 text-sm font-semibold text-brand-dark">
          {technology}
        </li>
      ))}
    </ul>
    <ul class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-6">
      {actions.map((action) => (
        <li>
          <ExternalLink
            href={action.href}
            language={language}
            demo={action.wakesApi}
            class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-brand underline decoration-2 underline-offset-4 hover:text-brand-dark"
          >
            <action.icon size={18} />
            {action.label}
          </ExternalLink>
        </li>
      ))}
    </ul>
  </div>
</article>
