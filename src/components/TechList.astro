---
type Props = {
  technologies: string[];
  label: string;
  tone: "surface" | "brand";
  class?: string;
};

const { technologies, label, tone, class: className } = Astro.props;
---

<ul
  aria-label={label}
  class:list={["flex flex-wrap gap-2 text-[13px] leading-5 font-medium", className]}
>
  {technologies.map((technology) => (
    <li
      class:list={[
        "rounded-md border px-2.5 py-1",
        tone === "brand" ? "border-on-brand/55 text-on-brand" : "border-border bg-bg text-text",
      ]}
    >
      {technology}
    </li>
  ))}
</ul>
