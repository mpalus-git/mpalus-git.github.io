---
import type { CollectionEntry } from "astro:content";
import EnlargeableScreenshot from "@/components/EnlargeableScreenshot.astro";
import Video from "@/components/Video.astro";
import type { Language } from "@/i18n/i18n";

type Props = {
  project: CollectionEntry<"projects">;
  language: Language;
};

const { project, language } = Astro.props;
const { screenshots, video } = project.data;
const desktopScreenshots = screenshots.filter((screenshot) => screenshot.device === "desktop");
const phoneScreenshots = screenshots.filter((screenshot) => screenshot.device === "phone");
const phoneVideo = video?.device === "phone" ? video : undefined;
const frameClass = "overflow-hidden rounded-lg border border-border bg-surface shadow-sm";
const captionClass = "mt-2 text-sm text-muted";
const singleDesktop = desktopScreenshots.length === 1;
const desktopSizes = singleDesktop
  ? "(min-width: 1152px) 725px, (min-width: 768px) 61vw, calc(100vw - 2rem)"
  : "(min-width: 1152px) 532px, (min-width: 768px) 46vw, calc(100vw - 2rem)";
---

<div class="mt-8 flex flex-col gap-10">
  {video?.device === "desktop" ? (
    <div class:list={[frameClass, "max-w-3xl"]}>
      <Video
        project={project.data.project}
        file={video.file}
        poster={video.poster}
        alt={video.alt}
        device="desktop"
      />
    </div>
  ) : null}
  {phoneScreenshots.length > 0 || phoneVideo ? (
    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {phoneVideo ? (
        <li class={frameClass}>
          <Video
            project={project.data.project}
            file={phoneVideo.file}
            poster={phoneVideo.poster}
            alt={phoneVideo.alt}
            device="phone"
          />
        </li>
      ) : null}
      {phoneScreenshots.map((screenshot) => (
        <li>
          <figure>
            <EnlargeableScreenshot
              image={screenshot.image}
              alt={screenshot.alt}
              device="phone"
              sizes="(min-width: 1152px) 254px, (min-width: 1024px) 22vw, (min-width: 640px) 30vw, 45vw"
              language={language}
              class={frameClass}
            />
            <figcaption class={captionClass}>{screenshot.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  ) : null}
  {desktopScreenshots.length > 0 ? (
    <ul class:list={["grid gap-6", singleDesktop ? "md:w-2/3" : "md:grid-cols-2"]}>
      {desktopScreenshots.map((screenshot) => (
        <li>
          <figure>
            <EnlargeableScreenshot
              image={screenshot.image}
              alt={screenshot.alt}
              device="desktop"
              sizes={desktopSizes}
              language={language}
              class={frameClass}
            />
            <figcaption class={captionClass}>{screenshot.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  ) : null}
</div>
