---
import { t, type Language } from "@/i18n/i18n";

type Props = {
  language: Language;
  class?: string;
};

const { language, class: className } = Astro.props;
const sources = [
  { x: 0, width: 190, label: t(language, "apiDiagramEndpoints") },
  { x: 210, width: 190, label: t(language, "apiDiagramJobs") },
];
const dependencies = [
  { x: 0, width: 86, label: t(language, "apiDiagramDomain") },
  { x: 98, width: 100, label: t(language, "apiDiagramCache") },
  { x: 210, width: 112, label: t(language, "apiDiagramDatabase") },
  { x: 334, width: 66, label: t(language, "apiDiagramEmail") },
];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="-2 -2 404 254"
  width="404"
  height="254"
  role="img"
  aria-labelledby="api-diagram-title api-diagram-description"
  class={className}
>
  <title id="api-diagram-title">{t(language, "apiDiagramTitle")}</title>
  <desc id="api-diagram-description">{t(language, "apiDiagramDescription")}</desc>
  <defs>
    <marker
      id="api-diagram-arrow"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0 0 10 5 0 10z" class="fill-brand"></path>
    </marker>
  </defs>
  {sources.map((box) => (
    <g>
      <rect
        x={box.x}
        y="0"
        width={box.width}
        height="44"
        rx="8"
        class="fill-surface stroke-brand"
        stroke-width="2"
      />
      <text
        x={box.x + box.width / 2}
        y="27"
        text-anchor="middle"
        class="fill-text text-[14px] font-semibold"
      >
        {box.label}
      </text>
      <line
        x1={box.x + box.width / 2}
        y1="46"
        x2={box.x + box.width / 2}
        y2="98"
        stroke-width="2"
        class="stroke-brand"
        marker-end="url(#api-diagram-arrow)"
      />
    </g>
  ))}
  <rect x="0" y="102" width="400" height="44" rx="8" class="fill-brand"></rect>
  <text x="200" y="129" text-anchor="middle" class="fill-on-brand text-[14px] font-bold">
    {t(language, "apiDiagramHandlers")}
  </text>
  {dependencies.map((box) => (
    <g>
      <line
        x1={box.x + box.width / 2}
        y1="148"
        x2={box.x + box.width / 2}
        y2="200"
        stroke-width="2"
        class="stroke-brand"
        marker-end="url(#api-diagram-arrow)"
      />
      <rect
        x={box.x}
        y="204"
        width={box.width}
        height="44"
        rx="8"
        class="fill-surface stroke-brand"
        stroke-width="2"
      />
      <text
        x={box.x + box.width / 2}
        y="231"
        text-anchor="middle"
        class="fill-text text-[12px] font-semibold"
      >
        {box.label}
      </text>
    </g>
  ))}
</svg>
