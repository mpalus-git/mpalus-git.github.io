---
import { t, type Language } from "@/i18n/i18n";

type Props = {
  language: Language;
  class?: string;
};

const { language, class: className } = Astro.props;
const sources = [
  { x: 0, width: 170, label: t(language, "apiDiagramEndpoints") },
  { x: 182, width: 118, label: t(language, "apiDiagramJobs") },
];
const dependencies = [
  { x: 0, width: 70, label: t(language, "apiDiagramDomain"), external: false },
  { x: 82, width: 100, label: t(language, "apiDiagramCache"), external: false },
  { x: 194, width: 106, label: t(language, "apiDiagramDatabase"), external: true },
];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="-2 -2 304 168"
  width="304"
  height="168"
  role="img"
  aria-labelledby="api-diagram-title api-diagram-description"
  class={className}
>
  <title id="api-diagram-title">{t(language, "apiDiagramTitle")}</title>
  <desc id="api-diagram-description">{t(language, "apiCardDiagramDescription")}</desc>
  <defs>
    <marker
      id="api-diagram-arrow"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0 0 10 5 0 10z" class="fill-brand"></path>
    </marker>
  </defs>
  {sources.map((box) => (
    <g>
      <rect
        x={box.x}
        y="0"
        width={box.width}
        height="40"
        rx="8"
        class="fill-surface stroke-brand"
        stroke-width="2"
      />
      <text
        x={box.x + box.width / 2}
        y="25"
        text-anchor="middle"
        class="fill-text text-[14px] font-bold"
      >
        {box.label}
      </text>
      <line
        x1={box.x + box.width / 2}
        y1="40"
        x2={box.x + box.width / 2}
        y2="60"
        stroke-width="2"
        class="stroke-brand"
        marker-end="url(#api-diagram-arrow)"
      />
    </g>
  ))}
  <rect x="0" y="62" width="300" height="40" rx="8" class="fill-brand"></rect>
  <text x="150" y="87" text-anchor="middle" class="fill-on-brand text-[14px] font-bold">
    {t(language, "apiDiagramHandlers")}
  </text>
  {dependencies.map((box) => (
    <g>
      <line
        x1={box.x + box.width / 2}
        y1="102"
        x2={box.x + box.width / 2}
        y2="122"
        stroke-width="2"
        class="stroke-brand"
        marker-end="url(#api-diagram-arrow)"
      />
      <rect
        x={box.x}
        y="124"
        width={box.width}
        height="40"
        rx="8"
        class:list={["fill-surface", box.external ? "stroke-muted" : "stroke-brand"]}
        stroke-width="2"
      />
      <text
        x={box.x + box.width / 2}
        y="149"
        text-anchor="middle"
        class="fill-text text-[13px] font-bold"
      >
        {box.label}
      </text>
    </g>
  ))}
</svg>
