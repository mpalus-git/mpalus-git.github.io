---
import type { Dictionary } from "@/i18n/dictionary";
import { t, type Language } from "@/i18n/i18n";

type Props = {
  language: Language;
  layout: "wide" | "narrow";
  class?: string;
};

type Box = {
  x: number;
  y: number;
  width: number;
  height: number;
  title: keyof Dictionary;
  detail: keyof Dictionary | null;
  variant: "client" | "inner" | "handlers" | "external" | "optional";
  wrap: boolean;
};

const { language, layout, class: className } = Astro.props;
const lineHeight = 17;
const box = (
  x: number,
  y: number,
  width: number,
  height: number,
  title: keyof Dictionary,
  detail: keyof Dictionary | null,
  variant: Box["variant"],
  wrap = false,
): Box => ({ x, y, width, height, title, detail, variant, wrap });
const layouts = {
  wide: {
    width: 400,
    height: 440,
    label: { x: 388, y: 86 },
    boxes: [
      box(0, 0, 190, 48, "apiDiagramWebClient", "apiDiagramWebClientTech", "client"),
      box(210, 0, 190, 48, "apiDiagramMobileClient", "apiDiagramMobileClientTech", "client"),
      box(12, 100, 236, 80, "apiDiagramEndpoints", "apiDiagramEndpointsDetail", "inner"),
      box(260, 100, 128, 80, "apiDiagramJobs", "apiDiagramJobsDetail", "inner", true),
      box(12, 212, 376, 44, "apiDiagramHandlers", null, "handlers"),
      box(12, 288, 112, 48, "apiDiagramCache", "apiDiagramCacheDetail", "inner"),
      box(136, 288, 124, 48, "apiDiagramDomain", "apiDiagramDomainDetail", "inner"),
      box(12, 392, 112, 48, "apiDiagramRedis", "apiDiagramRedisDetail", "optional"),
      box(136, 392, 124, 48, "apiDiagramEmail", "apiDiagramEmailDetail", "external"),
      box(272, 392, 116, 48, "apiDiagramDatabase", null, "external"),
    ],
    arrows: [
      "M95 48V98",
      "M305 48 212 98",
      "M130 180V210",
      "M324 180V210",
      "M68 256V286",
      "M198 256V286",
      "M276 256V370H198V390",
      "M330 256V390",
    ],
    optionalArrow: "M68 336V390",
  },
  narrow: {
    width: 310,
    height: 504,
    label: { x: 298, y: 86 },
    boxes: [
      box(0, 0, 144, 48, "apiDiagramWebClient", "apiDiagramWebClientTech", "client"),
      box(156, 0, 144, 48, "apiDiagramMobileClient", "apiDiagramMobileClientTech", "client"),
      box(12, 96, 150, 84, "apiDiagramEndpoints", "apiDiagramEndpointsDetail", "inner", true),
      box(172, 96, 126, 84, "apiDiagramJobs", "apiDiagramJobsDetail", "inner", true),
      box(12, 212, 286, 44, "apiDiagramHandlers", null, "handlers"),
      box(12, 288, 130, 48, "apiDiagramCache", "apiDiagramCacheDetail", "inner"),
      box(168, 288, 130, 48, "apiDiagramDomain", "apiDiagramDomainDetail", "inner"),
      box(12, 392, 130, 48, "apiDiagramRedis", "apiDiagramRedisDetail", "optional"),
      box(168, 392, 130, 48, "apiDiagramDatabase", null, "external"),
      box(168, 456, 130, 48, "apiDiagramEmail", "apiDiagramEmailDetail", "external"),
    ],
    arrows: [
      "M72 48V94",
      "M228 48 136 94",
      "M87 180V210",
      "M235 180V210",
      "M77 256V286",
      "M233 256V286",
      "M155 256V416H166",
      "M155 416V480H166",
    ],
    optionalArrow: "M77 336V390",
  },
};
const { width, height, label, boxes, arrows, optionalArrow } = layouts[layout];
const id = `api-architecture-${layout}`;
const viewBox = [-2, -2, width + 4, height + 4].join(" ");
const boxClasses: Record<Box["variant"], string> = {
  client: "fill-surface stroke-brand",
  inner: "fill-surface stroke-brand",
  handlers: "fill-brand stroke-brand",
  external: "fill-surface stroke-muted",
  optional: "fill-surface stroke-muted [stroke-dasharray:5_4]",
};
const paths = [
  ...arrows.map((path) => ({ path, optional: false })),
  { path: optionalArrow, optional: true },
];

function detailLines(detail: string, wrap: boolean): string[] {
  if (!wrap) {
    return [detail];
  }
  const parts = detail.split(", ");
  return parts.map((part, index) => (index < parts.length - 1 ? `${part},` : part));
}

function textLines(box: Box) {
  const details = box.detail ? detailLines(t(language, box.detail), box.wrap) : [];
  const lines = [
    { text: t(language, box.title), bold: true },
    ...details.map((text) => ({ text, bold: false })),
  ];
  const firstBaseline = box.y + box.height / 2 - ((lines.length - 1) * lineHeight) / 2 + 5;
  return lines.map((line, index) => ({ ...line, y: firstBaseline + index * lineHeight }));
}
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  width={width + 4}
  height={height + 4}
  role="img"
  aria-labelledby={`${id}-title ${id}-description`}
  class={className}
>
  <title id={`${id}-title`}>{t(language, "apiDiagramTitle")}</title>
  <desc id={`${id}-description`}>{t(language, "apiDiagramDescription")}</desc>
  <defs>
    <marker
      id={`${id}-arrow`}
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0 0 10 5 0 10z" class="fill-brand"></path>
    </marker>
  </defs>
  <rect
    x="0"
    y="64"
    width={width}
    height="288"
    rx="12"
    class="fill-brand-tint stroke-brand [stroke-dasharray:6_4]"
    stroke-width="1.5"
  ></rect>
  <text x={label.x} y={label.y} text-anchor="end" class="fill-brand-dark text-[14px] font-bold">
    {t(language, "diagramApiName")}
  </text>
  {paths.map((arrow) => (
    <path
      d={arrow.path}
      fill="none"
      stroke-width="2"
      class:list={["stroke-brand", arrow.optional && "[stroke-dasharray:5_4]"]}
      marker-end={`url(#${id}-arrow)`}
    />
  ))}
  {boxes.map((box) => (
    <g>
      <rect
        x={box.x}
        y={box.y}
        width={box.width}
        height={box.height}
        rx="8"
        stroke-width="2"
        class={boxClasses[box.variant]}
      />
      {textLines(box).map((line) => (
        <text
          x={box.x + box.width / 2}
          y={line.y}
          text-anchor="middle"
          class:list={[
            box.variant === "handlers" ? "fill-on-brand" : line.bold ? "fill-text" : "fill-muted",
            line.bold ? "text-[14px] font-bold" : "text-[13px]",
          ]}
        >
          {line.text}
        </text>
      ))}
    </g>
  ))}
</svg>
