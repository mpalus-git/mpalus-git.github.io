---
import { render, type CollectionEntry } from "astro:content";
import ApiArchitectureFullDiagram from "@/components/ApiArchitectureFullDiagram.astro";
import ProjectDetailsLink from "@/components/ProjectDetailsLink.astro";
import ProjectHero from "@/components/ProjectHero.astro";
import ProjectLinks from "@/components/ProjectLinks.astro";
import ProjectMedia from "@/components/ProjectMedia.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t, type Language } from "@/i18n/i18n";

type Props = {
  project: CollectionEntry<"projects">;
  otherProjects: CollectionEntry<"projects">[];
  language: Language;
};

const { project, otherProjects, language } = Astro.props;
const { Content } = await render(project);
const hasMedia = project.data.screenshots.length > 0 || project.data.video !== undefined;
---

<BaseLayout
  language={language}
  title={`${project.data.title} - ${t(language, "personName")}`}
  description={project.data.summary}
>
  <ProjectHero project={project} language={language} />
  <div class="mx-auto flex max-w-6xl flex-col gap-16 px-4 py-16 md:px-8">
    <section aria-labelledby="problem-heading">
      <SectionHeading id="problem-heading">{t(language, "projectProblemHeading")}</SectionHeading>
      <div class="mt-4 max-w-prose space-y-4 text-lg leading-relaxed">
        <Content />
      </div>
    </section>
    <section aria-labelledby="decisions-heading">
      <SectionHeading id="decisions-heading">
        {t(language, "projectDecisionsHeading")}
      </SectionHeading>
      <ol class="mt-8 border-t border-border">
        {project.data.decisions.map((decision, index) => (
          <li class="grid gap-2 border-b border-border py-6 md:grid-cols-3 md:gap-x-10 md:py-8">
            <div>
              <span aria-hidden="true" class="font-mono text-sm font-bold text-brand tabular-nums">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="text-xl font-bold">{decision.title}</h3>
            </div>
            <p class="max-w-prose leading-relaxed text-muted md:col-span-2 md:text-lg">
              {decision.body}
            </p>
          </li>
        ))}
      </ol>
    </section>
    {project.data.architectureDiagram ? (
      <section aria-labelledby="architecture-heading">
        <SectionHeading id="architecture-heading">
          {t(language, "projectArchitectureHeading")}
        </SectionHeading>
        <div class="mt-8 rounded-xl border border-border bg-surface px-2 py-4 shadow-sm md:p-8">
          <ApiArchitectureFullDiagram
            language={language}
            layout="narrow"
            class="mx-auto h-auto w-full max-w-sm sm:hidden"
          />
          <ApiArchitectureFullDiagram
            language={language}
            layout="wide"
            class="mx-auto hidden h-auto w-full max-w-xl sm:block"
          />
        </div>
      </section>
    ) : null}
    {hasMedia ? (
      <section aria-labelledby="media-heading">
        <SectionHeading id="media-heading">{t(language, "projectMediaHeading")}</SectionHeading>
        <ProjectMedia project={project} language={language} />
      </section>
    ) : null}
    <section aria-labelledby="demo-heading" class="rounded-xl bg-brand-tint p-6 md:p-8">
      <SectionHeading id="demo-heading">{t(language, "projectDemoHeading")}</SectionHeading>
      <p class="mt-4 max-w-prose text-lg leading-relaxed">{project.data.demo}</p>
      <ProjectLinks links={project.data.links} language={language} class="mt-4" />
    </section>
    <section aria-labelledby="other-projects-heading">
      <SectionHeading id="other-projects-heading">
        {t(language, "otherProjectsHeading")}
      </SectionHeading>
      <ul class="mt-8 grid gap-6 md:grid-cols-2">
        {otherProjects.map((other) => (
          <li class="rounded-xl border border-border bg-surface p-6 transition-colors hover:border-brand">
            <h3 class="text-xl font-bold">
              <ProjectDetailsLink project={other} language={language} />
            </h3>
            <p class="mt-2 text-muted">{other.data.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
