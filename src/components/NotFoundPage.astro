---
import ProjectSummaryList from "@/components/ProjectSummaryList.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { getProjects } from "@/content/projects";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLocalizedPath, t, type Language } from "@/i18n/i18n";

type Props = {
  language: Language;
};

const { language } = Astro.props;
const projects = await getProjects(language);
---

<BaseLayout
  language={language}
  title={t(language, "notFoundTitle")}
  description={t(language, "notFoundText")}
  noIndex
>
  <section class="mx-auto max-w-6xl px-4 py-16 md:px-8 md:py-24">
    <h1 class="text-3xl font-bold tracking-tight md:text-5xl">{t(language, "notFoundTitle")}</h1>
    <p class="mt-4 max-w-prose text-lg text-muted">{t(language, "notFoundText")}</p>
    <a
      href={getLocalizedPath("/", language)}
      class="mt-8 inline-flex min-h-11 items-center rounded-lg bg-brand px-5 font-semibold text-on-brand transition-colors hover:bg-brand-dark"
    >
      {t(language, "notFoundLink")}
    </a>
  </section>
  <section
    aria-labelledby="not-found-projects-heading"
    class="mx-auto max-w-6xl px-4 pb-16 md:px-8 md:pb-24"
  >
    <SectionHeading id="not-found-projects-heading">{t(language, "fixflowHeading")}</SectionHeading>
    <ProjectSummaryList
      projects={projects}
      language={language}
      class="md:grid-cols-2 lg:grid-cols-3"
    />
  </section>
</BaseLayout>
