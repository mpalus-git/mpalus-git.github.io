---
import FixFlowSection from "@/components/FixFlowSection.astro";
import Hero from "@/components/Hero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t, type Language } from "@/i18n/i18n";

type Props = {
  language: Language;
};

const { language } = Astro.props;
---

<BaseLayout language={language} title={t(language, "homeTitle")}>
  <Hero language={language} />
  <FixFlowSection language={language} />
</BaseLayout>
