---
import { t, type Language } from "@/i18n/i18n";

type Props = {
  href: string;
  language: Language;
  class?: string;
  demo?: boolean;
};

const { href, language, class: className, demo = false } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class={className}
  data-demo-link={demo ? "" : undefined}
>
  <slot />
  <span class="sr-only">{t(language, "opensInNewTab")}</span>
</a>
